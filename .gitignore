AtomicRedTeam/
atomic-red-team/
invoke-atomicredteam/

# --- big media ---
*.mp4
*.mov
*.mkv

# --- large raw logs (push filtered exports in evidence/logs instead) ---
*.log
evidence/logs/raw/

# --- Python / OS / editors ---
__pycache__/
*.pyc
.venv/
.DS_Store
Thumbs.db
.vscode/
.idea/
~$*
