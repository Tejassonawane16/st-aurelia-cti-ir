# --- secrets ---
.env
*.env
secrets*
*password*
*.kdbx
*.pem
*.key

# --- VM images and installers ---
*.ova
*.ovf
*.vdi
*.vmdk
*.vhd
*.vhdx
*.iso
*.qcow2

# --- memory / credential dumps ---
*.dmp
*.mem
*.raw
